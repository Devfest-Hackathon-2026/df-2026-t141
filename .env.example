# ローカル用の設定の見本。これを .env という名前でコピーして値を入れる。
# .env は .gitignore に入っているのでコミットされない。キーをこのファイル（.env.example）に書かないこと。
# 空のままの項目は開発用の偽物で動く（画面上部に「開発モード」の帯が出る）。

# 公園（シェルター）の検索。サーバーからだけ使うキー。本番では Secret Manager に入れる
PLACES_API_KEY=

# 逃走中の地図の徒歩ルート。空なら PLACES_API_KEY を使う（キーの制限で Routes API も許可する）
ROUTES_API_KEY=

# 外のマップ。ブラウザから見えるキーなので、Places のキーとは別に作る
MAPS_BROWSER_KEY=
MAPS_MAP_ID=

# 保存を Firestore にする場合（ローカルでは空のままでよい）
GOOGLE_CLOUD_PROJECT=
USE_FIRESTORE=

# 状況に応じた通知（Firebase Cloud Messaging）。GOOGLE_CLOUD_PROJECT とこの5つをすべて入れたときだけ通知のボタンが出る。手順は docs/gcp-setup.md の 3-3
# FIREBASE_* はブラウザへ渡す値で秘密ではない。NOTIFY_SECRET は定期実行の合言葉なので本番では Secret Manager に入れる
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_VAPID_KEY=
NOTIFY_SECRET=
# 通知に載せる拠点のURLの頭（例: https://zombie-run-xxxx.a.run.app）。空なら届いたリクエストのURLを使う
PUBLIC_BASE_URL=
